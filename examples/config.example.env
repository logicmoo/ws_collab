# WS_COLLAB example configuration (copy values into your environment).
# Every setting is optional; defaults are safe (loopback + authentication on).

# ---- Networking / binding ----
WS_COLLAB_HOST=127.0.0.1
WS_COLLAB_HTTP_PORT=8802
# Enable HTTPS by setting a port AND both TLS files:
# WS_COLLAB_HTTPS_PORT=8803
# WS_COLLAB_TLS_CERT_FILE=/path/to/cert.pem
# WS_COLLAB_TLS_KEY_FILE=/path/to/key.pem
# Restrict/expand bind addresses (comma separated). Loopback only by default.
# WS_COLLAB_BIND_ADDRESSES=127.0.0.1
# Administration is loopback-only unless explicitly enabled (requires TLS):
# WS_COLLAB_ADMIN_REMOTE=0

# ---- Single writable state directory ----
WS_COLLAB_STATE_DIR=collab_state
# WS_COLLAB_JSONL_DIR defaults to the state dir; override to separate streams.
# WS_COLLAB_ROTATE_MAX_BYTES=67108864
# WS_COLLAB_RETENTION_MAX_FILES=20

# ---- Security ----
# token=role pairs (roles: viewer < worker < operator < admin). If omitted, a
# random admin token is generated and written to collab_state/generated_admin_token.txt
# WS_COLLAB_TOKENS=super-secret=admin,worker-tok=worker,view-tok=viewer
# WS_COLLAB_ADMIN_TOKEN=super-secret
# WS_COLLAB_SESSION_SECRET=change-me-to-a-long-random-string
# WS_COLLAB_TRUSTED_ORIGINS=https://ops.example.com
# WS_COLLAB_ALLOWLIST=127.0.0.1/32,10.0.0.0/8
# WS_COLLAB_REQUIRE_TLS=1
# WS_COLLAB_DEV_INSECURE=0
# WS_COLLAB_RATE_LIMIT_RPS=50
# WS_COLLAB_MAX_BODY_BYTES=1048576
# WS_COLLAB_MAX_WS_MESSAGE_BYTES=1048576
# WS_COLLAB_MAX_CONNECTIONS=256

# ---- Worker monitoring thresholds (seconds) ----
WS_COLLAB_WORKER_WARN_SECONDS=60
WS_COLLAB_WORKER_OVERDUE_SECONDS=120
WS_COLLAB_WORKER_UNRESPONSIVE_SECONDS=300

# ---- Agents (enumerated identities) ----
# WS_COLLAB_AGENT_1=WS_COLLAB_AGENT_planner
# WS_COLLAB_AGENT_2=WS_COLLAB_AGENT_solver

# ---- Audio (always-listening must be explicitly enabled) ----
# Real hardware is used when available; `fake` forces the hardware-free doubles.
WS_COLLAB_AUDIO_ENABLED=0
WS_COLLAB_AUDIO_BACKEND=auto
# WS_COLLAB_AUDIO_INPUT_DEVICE=
WS_COLLAB_ECHO_POLICY=listen_and_filter_tts

# ---- STT (three independent engines; each falls back to a double if missing) ----
# Default: two Whisper sizes plus an independent Kaldi-based recognizer.
WS_COLLAB_STT_ENGINES=whisper:tiny.en,whisper:base.en,vosk
# WS_COLLAB_VOSK_MODEL=/path/to/vosk-model-small-en-us-0.15
# Fully hardware-free (used by the test suite):
# WS_COLLAB_STT_ENGINES=fallback_alpha,fallback_beta,fallback_gamma
# With an explicitly configured remote provider:
# WS_COLLAB_STT_ENGINES=whisper:small.en,vosk,remote:https://stt.example/api
# WS_COLLAB_STT_TIMEOUT_MS=120000
# WS_COLLAB_STT_CONCURRENCY=3
# WS_COLLAB_STT_ALLOW_REMOTE=0

# ---- Final disambiguator ----
WS_COLLAB_DISAMBIGUATOR=deterministic
# WS_COLLAB_DISAMBIGUATOR=llm
# WS_COLLAB_DISAMBIGUATOR_ALLOW_REMOTE=0
# WS_COLLAB_DISAMBIGUATOR_LLM_ENDPOINT=https://llm.example/resolve

# ---- TTS ----
WS_COLLAB_TTS_BACKEND=auto
WS_COLLAB_TTS_POLICY=unique_when_possible
